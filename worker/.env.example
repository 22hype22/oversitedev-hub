SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...                    # public anon/publishable key (safe to ship)
WORKER_TOKEN=wkr_...                             # generate in Admin → Worker tokens
WORKER_ID=worker-1
POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=30000

# Oversite Utilities bot (system bot for preorder DM confirmations).
# Leave unset to disable.
OVERSITE_UTILITIES_BOT_TOKEN=
UTILS_POLL_INTERVAL_MS=5000

# Shared secret used when invoking the charge-confirmed-order edge function
# from the utilities bot. Must match INTERNAL_CHARGE_SECRET in Cloud secrets.
INTERNAL_CHARGE_SECRET=
